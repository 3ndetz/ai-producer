# API Keys
GOOGLE_API_KEY=your_google_ai_studio_key_here
OPENROUTER_API_KEY=your_openrouter_key_here
MISTRAL_API_KEY=your_mistral_key_here

# Models
IMAGE_GENERATION_BACKEND=comfy
IMAGE_GEN_MODEL=gemini-2.0-flash-exp-image-generation
COMFY_URL=http://127.0.0.1:8000/
COMFY_WORKFLOW_PATH=./data/workflows/z_image_turbo_gguf.json
COMFY_UNET_NAME=z_image_turbo-Q3_K_S.gguf
COMFY_CLIP_NAME=Qwen3-4B-Q3_K_S.gguf
COMFY_CLIP_TYPE=qwen_image
COMFY_SAVE_NODE_ID=11
COMFY_POLL_INTERVAL=1.5
COMFY_POLL_TIMEOUT=600.0
COMFY_VAE_NAME=ae.safetensors
COMFY_NEGATIVE_PROMPT="blurry ugly bad"
COMFY_WIDTH=128
COMFY_HEIGHT=128
COMFY_BATCH_SIZE=1
COMFY_STEPS=2
COMFY_CFG=1.0
COMFY_SAMPLER_NAME=euler
COMFY_SCHEDULER=simple
COMFY_DENOISE=1.0
COMFY_SEED=526213216603105

VLM_MODEL_TYPE=local
VLM_MODEL_LOCAL=mlx-community/Qwen2-VL-2B-Instruct-4bit
VLM_MODEL_API=gemini-2.0-flash-exp-image-generation
LLM_MODEL_OPENROUTER=deepseek/deepseek-chat-v3.1:free

LLM_MODEL_TYPE=mistral
LLM_MODEL_MISTRAL=mistral-small-latest
LLM_MODEL_LOCAL=mlx-community/Mistral-7B-Instruct-v0.3-4bit

# Iteration Parameters
MAX_ITERATIONS=5
MIN_QUALITY_SCORE=8.0
DEFAULT_ITERATIONS_WITHOUT_FEEDBACK=1

# Max Tokens for Agents
PLANNER_MAX_TOKENS=500
GENERATOR_MAX_TOKENS=500
VLM_MAX_TOKENS=512
CRITIC_REQUIREMENTS_MAX_TOKENS=600
CRITIC_COMPARISON_MAX_TOKENS=600

# Paths
OUTPUT_DIR=./data/images

# Web Server
WEB_HOST=0.0.0.0
WEB_PORT=8008

# Backend Server
BACKEND_URL=http://localhost:8001
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8001
HTTP_TIMEOUT=120

# Test Mode Stubs
USE_VLM_STUBS=true
USE_LLM_STUBS=false
USE_IMAGE_GEN_STUBS=true

# PostgreSQL
POSTGRES_USER=chainlit_user
POSTGRES_PASSWORD=chainlit_pass
POSTGRES_DB=postgres_db
POSTGRES_PORT=5432
POSTGRES_HOST=127.0.0.1

# UI Database Settings (Chainlit)
UI_DB_NAME=chainlit_db
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${UI_DB_NAME}"
CHAINLIT_AUTH_SECRET=your_chainlit_auth_secret_here

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=supersecretpassword

# Настройки AWS-совместимого доступа (для MinIO)
APP_AWS_REGION=us-east-1
APP_AWS_ACCESS_KEY="${MINIO_ROOT_USER}"
APP_AWS_SECRET_KEY="${MINIO_ROOT_PASSWORD}"
DEV_AWS_ENDPOINT=http://localhost:9000
BUCKET_NAME=attachments